{
  "expo": {
    "name": "신과함께",
    "slug": "WithGod",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./src/shared/assets/images/icon.png",
    "scheme": "withgod",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/89ef64a4-7131-472f-89aa-7de04f4256fe"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.co.mincha.withgod",
      "appleTeamId": "B434W34DLF",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "말씀 카드를 사진 앨범에 저장하기 위해 사용됩니다."
      }
    },
    "android": {
      "package": "kr.co.mincha.withgod",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/shared/assets/AppIcons/android/mipmap-xxxhdpi/ic_launcher.png"
      },
      "splash": {
        "backgroundColor": "#4A90E2",
        "resizeMode": "cover"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./src/shared/assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ],
      "./plugins/with-rnfirebase-static-framework",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DailyVerse",
              "label": "오늘의 말씀",
              "description": "매일 새로운 말씀을 홈 화면에서 만나보세요",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./src/shared/assets/widget/daily-verse-preview.png"
            }
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/shared/assets/images/icon.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#4A90E2",
          "dark": {
            "backgroundColor": "#4A90E2"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89ef64a4-7131-472f-89aa-7de04f4256fe"
      }
    },
    "owner": "sunghong32"
  }
}
