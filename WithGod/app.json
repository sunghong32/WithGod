{
  "expo": {
    "name": "신과함께",
    "slug": "WithGod",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/shared/assets/images/icon.png",
    "scheme": "withgod",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/89ef64a4-7131-472f-89aa-7de04f4256fe"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.co.mincha.withgod",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kr.co.mincha.withgod",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/shared/assets/AppIcons/android/mipmap-xxxhdpi/ic_launcher.png"
      },
      "splash": {
        "backgroundColor": "#4A90E2",
        "resizeMode": "cover"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "navigationBarColor": "#4A90E2"
    },
    "web": {
      "output": "static",
      "favicon": "./src/shared/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/shared/assets/images/icon.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#4A90E2",
          "dark": {
            "backgroundColor": "#4A90E2"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89ef64a4-7131-472f-89aa-7de04f4256fe"
      }
    },
    "owner": "sunghong32"
  }
}
