# /etc/with-god-ig.env (root:root 600) — 인스타 Daily Verse 게시 설정. 이 예시만 레포에 있다.
# dry-run: 카드·캡션을 만들어 텔레그램으로 보내기만 한다. live: 실제로 올린다.
IG_MODE=dry-run
# Facebook 페이지에 연결한 인스타 계정 + 비즈니스 관리자 시스템 사용자 토큰(만료 없음).
# 권한: instagram_basic, instagram_content_publish (+ pages_show_list, pages_read_engagement)
IG_API_HOST=https://graph.facebook.com
IG_ACCESS_TOKEN=
# 게시할 인스타 계정 id(Facebook 경로에서는 필수)
IG_USER_ID=
IG_S3_BUCKET=with-god-ig-cards
IG_S3_REGION=ap-northeast-2
# 이 날짜(미국 동부) 전에는 올리지 않는다(비워 두면 바로). 예: 2026-11-13
IG_START_DATE=
