# /etc/with-god-ig.env (root:root 600) — 인스타 Daily Verse 게시 설정. 이 예시만 레포에 있다.
# dry-run: 카드·캡션을 만들어 텔레그램으로 보내기만 한다. live: 실제로 올린다.
IG_MODE=dry-run
# Meta 앱 대시보드 → Instagram → API setup with Instagram business login → Generate token 으로 받은 60일 토큰.
# 갱신본은 상태 디렉터리(token.json)에 쌓이고, 여기 값을 바꾸면 새 토큰으로 다시 시작한다.
IG_ACCESS_TOKEN=
# 비우면 /me 로 알아낸다.
IG_USER_ID=
IG_S3_BUCKET=with-god-ig-cards
IG_S3_REGION=ap-northeast-2
